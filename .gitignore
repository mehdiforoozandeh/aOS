# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Environment / secrets
.env
.env.*
!.env.example

# git-crypt key — shared out of band, never commit it
*.key
aOS-git-crypt.key

# Logs and temp files
*.log
tmp/
temp/

# Dependencies and build output
node_modules/
dist/

# Python bytecode from the Hermes plugin
__pycache__/
*.py[cod]

# Scratch directories the services create at runtime
.claude-cwd/
.agent-cwd/
